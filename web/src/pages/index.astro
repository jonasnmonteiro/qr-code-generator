---
import BaseLayout from '../layouts/BaseLayout.astro';
import QRStudio from '../components/QRStudio';
---

<BaseLayout title="Interactive QR Code Studio">
  <div style="text-align: center; padding: 48px 16px 16px 16px;">
    <div style="display: inline-block; padding: 4px 14px; border-radius: 20px; background: rgba(99, 102, 241, 0.15); border: 1px solid rgba(99, 102, 241, 0.3); font-size: 12px; font-weight: 600; color: var(--accent-cyan); margin-bottom: 16px;">
      60 FPS WebAssembly Engine
    </div>
    <h1 style="font-size: clamp(32px, 5vw, 48px); font-weight: 800; letter-spacing: -1px; margin-bottom: 12px; background: linear-gradient(135deg, #FFFFFF 0%, #94A3B8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      Next-Gen QR Code Customizer
    </h1>
    <p style="font-size: 16px; color: var(--text-secondary); max-width: 600px; margin: 0 auto;">
      Design beautiful, scannable QR codes with fluid organic shapes, asymmetrical eyes, custom gradients, and center logos.
    </p>
  </div>

  <QRStudio client:load />
</BaseLayout>
